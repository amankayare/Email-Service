# --- Git Clone Stage ---
FROM alpine:3.19 AS git
RUN apk add --no-cache git
WORKDIR /src
RUN git clone --depth 1 https://github.com/amankayare/Email-Service.git .

# --- Base Stage ---
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app

# --- Build Stage ---
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY --from=git /src/EmailService.Worker/EmailService.Worker.csproj EmailService.Worker/
COPY --from=git /src/EmailService.Core/EmailService.Core.csproj EmailService.Core/
COPY --from=git /src/EmailService.Infrastructure/EmailService.Infrastructure.csproj EmailService.Infrastructure/

RUN dotnet restore "EmailService.Worker/EmailService.Worker.csproj"

COPY --from=git /src/ .
WORKDIR "/src/EmailService.Worker"
RUN dotnet build "EmailService.Worker.csproj" -c Release -o /app/build

# --- Publish Stage ---
FROM build AS publish
RUN dotnet publish "EmailService.Worker.csproj" -c Release -o /app/publish /p:UseAppHost=false

# --- Final Stage ---
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "EmailService.Worker.dll"]
